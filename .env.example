# Copia este archivo a .env y rellena los valores. Nunca subas .env al repo.

# OddsPapi (https://oddspapi.io), candidata principal: casas .es + Pinnacle
ODDSPAPI_KEY=

# The Odds API (https://the-odds-api.com), respaldo gratuito
ODDS_API_KEY=

# Betfair Exchange API (cuenta en betfair.es + app key)
BETFAIR_APP_KEY=
BETFAIR_USERNAME=
BETFAIR_PASSWORD=

# Telegram (ver README: @BotFather y luego `python -m bot_apuestas telegram-chat-id`)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Ajustes del bot (opcionales; estos son los valores por defecto)
# BOT_BOOKS=winamax.es,codere.es,bet365.es
# BOT_REFERENCE=pinnacle
# BOT_TOURNAMENTS=8,17
# BOT_MIN_EDGE=0.03
# BOT_MAX_HOURS=72
# BOT_MAX_MARKET_AGE_H=24
# BOT_POLL_MINUTES=30
# BOT_ACTIVE_HOURS=8-23
# BOT_STAKE_EUR=10
# Surebets (vacío = desactivadas, ahorra 2 peticiones por consulta)
# BOT_SUREBET_BOOKS=winamax.es,codere.es,bet365.es,betway.es,bwin.es
# BOT_SUREBET_MIN_PROFIT=0.005
# BOT_SUREBET_STAKE_EUR=100
